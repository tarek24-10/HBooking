@model IEnumerable<HBook.Domain.Entities.Hotel>

<div class="card border-0 p-4">
    <div class="card-header bg-success bg-gradient py-3">Hotel List</div>
    <div class="card-body border py-4">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <td>Name</td>
                    <td>Price</td>
                    <td>Sqft</td>
                    <td>Occupancy</td>
                </tr>
            </thead>
            <tbody>
                <div class="row pb-3">
                    <div class="col-6 offset-6 text-end">
                        <a class="btn btn-secondary" asp-controller="Hotel" asp-action="Create"><i class="bi bi-plus-circle"></i> Add New Hotel</a>
                    </div>
                </div>
                @foreach (var obj in Model)
                {
                    <tr>
                        <td>@obj.Name</td>
                        <td>@obj.Price</td>
                        <td>@obj.Sqft</td>
                        <td>@obj.Occupancy</td>
                        <td>
                            <div class="w-75 btn-group" role="group">
                                <a asp-controller="Hotel" asp-action="Update" asp-route-Id="@obj.Id" class="btn btn-success mx-2"><i class="bi bi-pencil-square"></i> Update</a>
                                <a asp-action="Delete" asp-route-Id="@obj.Id" class="btn btn-danger mx-2"><i class="bi bi-trash-fill"></i> Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
