@model IEnumerable<HBook.Domain.Entities.Hotel> 

<h1>Hotel List</h1>

<table class="table tale-bordered table-striped">
    <thead>
    <tr>
        <td>Name</td>
        <td>Price</td>
        <td>Sqft</td>
        <td>Occupancy</td>
    </tr>
    </thead>
    <tbody>
        @foreach (var obj in Model)
        {
            <tr>
                <td>@obj.Name</td>
                <td>@obj.Price</td>
                <td>@obj.Sqft</td>
                <td>@obj.Occupancy</td>
            </tr>
        }
    </tbody>
</table>