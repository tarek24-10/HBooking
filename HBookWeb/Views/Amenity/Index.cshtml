@model IEnumerable<Amenity>

<div class="card border-0 p-4">
    <div class="card-header bg-success bg-gradient py-3">Amenity List</div>
    <div class="card-body border py-4">
        <div class="row pb-3">
            <div class="col-6 offset-6 text-end">
                <a class="btn btn-secondary" asp-controller="Amenity" asp-action="Create"><i class="bi bi-plus-circle"></i> Add New Amenity</a>
            </div>
        </div>
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Hotel</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obj in Model)
                {
                    <tr>
                        <td>@obj.Id</td>
                        <td>@obj.Name</td>
                        <td>@obj.Hotel.Name</td>
                        <td>@obj.Description</td>
                        <td>
                            <div class="w-75 btn-group" role="group">
                                <a asp-controller="Amenity" asp-action="Update" asp-route-Id="@obj.Id" class="btn btn-success mx-2"><i class="bi bi-pencil-square"></i> Update</a>
                                <a asp-controller="Amenity" asp-action="Delete" asp-route-Id="@obj.Id" class="btn btn-danger mx-2"><i class="bi bi-trash-fill"></i> Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
        