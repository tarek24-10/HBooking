@model IEnumerable<HBook.Domain.Entities.Room>

<div class="card border-0 p-4">
    <div class="card-header bg-success bg-gradient py-3">Room List</div>
    <div class="card-body border py-4">
        <div class="row pb-3">
            <div class="col-6 offset-6 text-end">
                <a class="btn btn-secondary" asp-controller="Room" asp-action="Create"><i class="bi bi-plus-circle"></i> Add New Room</a>
            </div>
        </div>
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Room Number</th>
                    <th>Hotel</th>
                    <th>Special Details</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obj in Model)
                {
                    <tr>
                        <td>@obj.RoomNumber</td>
                        <td>@obj.HotelId</td>
                        <td>@obj.SpecialDetails</td>
                        <td>
                            <div class="w-75 btn-group" role="group">
                                <a asp-controller="Room" asp-action="Update" asp-route-hotelId="@obj.HotelId" asp-route-roomNumber="@obj.RoomNumber" class="btn btn-success mx-2"><i class="bi bi-pencil-square"></i> Update</a>
                                <a asp-controller="Room" asp-action="Delete" asp-route-hotelId="@obj.HotelId" asp-route-roomNumber="@obj.RoomNumber" class="btn btn-danger mx-2"><i class="bi bi-trash-fill"></i> Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
        