@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav flex-row flex-wrap align-items-center gap-2 mb-0 ms-auto">
    <li class="nav-item d-flex align-items-center">
        <div class="form-check form-switch form-check-reverse mb-0">
            <label class="form-check-label" for="switchCheckDefault">Switch to dark mode</label>
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault" onclick="toggleTheme()">
        </div>
    </li>
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle text-nowrap" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Hello @UserManager.GetUserName(User)
        </a>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
            <li>
                <a class="dropdown-item text-center" asp-controller="Account" asp-action="Logout">Log out</a>
            </li>
        </ul>
    </li>
</ul>

<script>
    function toggleTheme() {
        const html = document.documentElement;

        if (html.getAttribute("data-bs-theme") === "dark") {
            html.setAttribute("data-bs-theme", "light");
        }
        else {
            html.setAttribute("data-bs-theme", "dark");
        }
    }
</script>

