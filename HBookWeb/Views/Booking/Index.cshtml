@model IEnumerable<Booking>

<div class="card border-0 p-4">
    <div class="card-header bg-success bg-gradient py-3">Booking List</div>
    <div class="card-body border py-4">
        <table id="tblBookings" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Check In Date</th>
                    <th>Nights</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
               
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/booking.js"></script>
}