@using HBook.Application.Common.Utility
@model IEnumerable<Booking>

@{
    var status = Context.Request.Query["status"];
    var pending = "";
    var approved = "";
    var checkedIn = "";
    var completed = "";
    var cancelled = "";


    switch (status)
    {
        case SD.StatusPending:
            pending = "btn-success text-white";
            break;
        case SD.StatusApproved:
            approved = "btn-success text-white";
            break;
        case SD.StatusCheckedIn:
            checkedIn = "btn-success text-white";
            break;
        case SD.StatusCompleted:
            completed = "btn-success text-white";
            break;
        case SD.StatusCancelled:
            cancelled = "btn-success text-white";
            break;
    }
}

<div class="card shadow-sm border-0 p-4">
    <div class="card-header bg-success bg-gradient text-white py-3">Booking List</div>
    <div class="card-body border py-4">
        <div class="d-flex justify-content-end flex-wrap gap-2 pb-4 pt-2">
            <a asp-controller="Booking" asp-action="Index" asp-route-status="@SD.StatusPending" class="btn btn-sm btn-outline-success text-nowrap @pending">@SD.StatusPending</a>
            <a asp-controller="Booking" asp-action="Index" asp-route-status="@SD.StatusApproved" class="btn btn-sm btn-outline-success text-nowrap @approved">@SD.StatusApproved</a>
            <a asp-controller="Booking" asp-action="Index" asp-route-status="@SD.StatusCheckedIn" class="btn btn-sm btn-outline-success text-nowrap @checkedIn">@SD.StatusCheckedIn</a>
            <a asp-controller="Booking" asp-action="Index" asp-route-status="@SD.StatusCompleted" class="btn btn-sm btn-outline-success text-nowrap @completed">@SD.StatusCompleted</a>
            <a asp-controller="Booking" asp-action="Index" asp-route-status="@SD.StatusCancelled" class="btn btn-sm btn-outline-success text-nowrap @cancelled">@SD.StatusCancelled</a>
        </div>
        <div class="table-responsive">
            <table id="tblBookings" class="table table-bordered table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Check In Date</th>
                    <th>Nights</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
               
            </tbody>
            </table>
        </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/booking.js"></script>
}